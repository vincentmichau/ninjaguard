# NightWatch - Configuration Backend (Multi-Plateforme)
# Node.js/Express Backend - Sert toutes les applications (React Web, PHP Web, React Native Mobile)

# Port du serveur
PORT=5000

# Environnement
NODE_ENV=development

# URLs des Frontends (multi-plateforme)
FRONTEND_URL=http://localhost:5173
REACT_FRONTEND_URL=http://localhost:5173
PHP_FRONTEND_URL=http://localhost:8000
MOBILE_FRONTEND_URL=http://localhost:19006

# Base de données MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=nightwatch

# JWT Secret (IMPORTANT: Changez en production)
JWT_SECRET=votre-cle-secrete-changez-en-production
JWT_EXPIRES_IN=24h

# Configuration Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=votre-mot-de-passe
SMTP_FROM=noreply@nightwatch.fr

# Configuration Uploads
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/jpg,image/webp

# Configuration API RH Combo
COMBO_API_URL=https://api.combo.example.com
COMBO_API_KEY=votre-cle-api-combo

# Configuration Socket.io
SOCKET_PATH=/socket.io